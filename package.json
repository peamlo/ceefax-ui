{
  "name": "@peamlo/ceefax-ui",
  "version": "0.5.0",
  "description": "Ceefax / teletext-inspired, framework-agnostic CSS-first design system.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peamlo/ceefax-ui.git"
  },
  "sideEffects": [
    "*.css",
    "./src/elements/*.js"
  ],
  "files": [
    "dist",
    "src",
    "fonts/*.woff2",
    "fonts/OFL.txt"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./css": "./dist/index.css",
    "./tokens": "./dist/tokens.css",
    "./elements": "./src/elements/index.js",
    "./elements/cf-loader": "./src/elements/cf-loader.js",
    "./elements/cf-canvas": "./src/elements/cf-canvas.js",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "postcss src/index.css -o dist/index.css && postcss src/tokens/_index.css -o dist/tokens.css && esbuild dist/index.css dist/tokens.css --minify --outdir=dist --allow-overwrite --log-level=warning",
    "demo": "npx --yes serve .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run",
    "assert-package": "node scripts/assert-package.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "lint": "stylelint \"src/**/*.css\" && eslint . && prettier --check .",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix && eslint . --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/html-vite": "^10.6.4",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "js-beautify": "^2.0.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-url": "^10.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.0",
    "storybook": "^10.6.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,html}": "prettier --write"
  }
}
