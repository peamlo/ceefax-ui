{
  "name": "@peamlo/ceefax-ui",
  "version": "0.1.0",
  "description": "Ceefax / teletext-inspired, framework-agnostic CSS-first design system.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "fonts"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./css": "./dist/index.css",
    "./tokens": "./dist/tokens.css",
    "./elements": "./src/elements/index.js",
    "./elements/cf-loader": "./src/elements/cf-loader.js",
    "./elements/cf-canvas": "./src/elements/cf-canvas.js",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "postcss src/index.css -o dist/index.css && postcss src/tokens/_index.css -o dist/tokens.css",
    "demo": "npx --yes serve .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --testTimeout=60000",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/html-vite": "^8.3.0",
    "@storybook/test": "^8.3.0",
    "@storybook/test-runner": "^0.19.0",
    "autoprefixer": "^10.4.0",
    "axe-playwright": "^2.0.0",
    "husky": "^9.1.7",
    "js-beautify": "^2.0.3",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "postcss-url": "^10.1.3",
    "storybook": "^8.3.0",
    "vite": "^5.4.0"
  }
}
