{
  // Spike #193: type-checks story `parameters.checks` against the names in .storybook/checks.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["dom", "dom.iterable", "es2024"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    ".storybook/checks.ts",
    "stories/Button.stories.js",
    "stories/Fastext.stories.js",
    "stories/layout/Page.stories.js"
  ]
}
